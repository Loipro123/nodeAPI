{
  "name": "node-typescript-api",
  "version": "1.0.0",
  "description": "A simple Node.js TypeScript project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "security:audit": "npm audit",
    "security:snyk": "npx snyk test",
    "security:snyk:monitor": "npx snyk monitor",
    "security:snyk:auth": "npx snyk auth",
    "security:snyk:config": "npx snyk config",
    "security:docker": "./scripts/docker-security-scan.sh",
    "docker:build": "docker build -t nodeapi .",
    "docker:build:dev": "docker build --target development -t nodeapi:dev .",
    "docker:run": "docker run -p 3000:3000 nodeapi",
    "docker:run:dev": "docker run -p 3000:3000 -v $(pwd):/app nodeapi:dev",
    "docker:compose:dev": "docker-compose up app-dev",
    "docker:compose:prod": "docker-compose --profile production up app-prod",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "test:ci": "jest --coverage --watchAll=false --silent --forceExit --detectOpenHandles",
    "typecheck": "tsc --noEmit",
    "pr-check": "npm run clean && npm run typecheck && npm run format:check && npm run lint && npm run test:ci && npm run security:audit && npm run security:snyk && npm run build",
    "pr-check:fix": "npm run clean && npm run format && npm run lint:fix && npm run test:ci && npm run security:audit && npm run security:snyk && npm run build",
    "pr-check:fast": "npm run typecheck && npm run format:check && npm run lint && npm run test:ci && npm run build",
    "pr-fullcheck": "npm run pr-check && npm run security:docker",
    "pr-fullcheck:fix": "npm run pr-check:fix && npm run security:docker",
    "pre-commit": "npm run format:check && npm run lint && npm run typecheck"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-sdk": "^0.0.42",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "snyk": "^1.1300.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.2",
    "express": "^4.18.2"
  }
}
