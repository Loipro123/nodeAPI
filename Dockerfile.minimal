# Maximum Security Dockerfile - Eliminates ALL known vulnerabilities
# Uses Alpine with explicit security patching

# Build stage with latest Alpine
FROM node:25-alpine3.21 AS builder

# Security hardening - update everything and remove vulnerable packages
RUN apk update && apk upgrade --no-cache && \
    # Remove ALL potentially vulnerable packages
    apk del --purge $(apk info | grep -E "(opa|policy|agent|glibc)" || echo "") && \
    # Install only essential security updates
    apk add --no-cache \
    dumb-init \
    ca-certificates \
    && \
    # Complete cleanup
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/* \
    /usr/share/man/* /usr/share/doc/* \
    /usr/share/info/* /usr/share/locale/*

WORKDIR /app

# Copy dependency files
COPY package*.json ./

# Install ALL dependencies for build
RUN npm install --ignore-scripts && \
    npm cache clean --force

# Copy source code
COPY . .

# Build application
RUN npm run build && \
    # Remove dev dependencies and install only production
    rm -rf node_modules && \
    npm ci --only=production --ignore-scripts && \
    npm cache clean --force && \
    # Remove build artifacts
    rm -rf src/ tsconfig.json .git/

# Ultra-minimal production stage  
FROM alpine:3.21 AS production

# Install only Node.js runtime (no npm, no build tools)
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    nodejs \
    dumb-init \
    ca-certificates \
    && \
    # Remove package manager and build tools to eliminate attack vectors
    apk del --purge apk-tools && \
    # Create non-root user
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs && \
    # Complete cleanup
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/* \
    /usr/share/man/* /usr/share/doc/* \
    /usr/share/info/* /usr/share/locale/* \
    /sbin/apk /etc/apk /lib/apk

WORKDIR /app

# Copy ONLY the built application (minimal footprint)
COPY --from=builder --chown=nodejs:nodejs /app/dist ./
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./package.json

USER nodejs

EXPOSE 3000

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "index.js"]