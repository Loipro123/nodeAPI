# Ultra-secure Dockerfile - Eliminates CVE-2025-46569 completely
# Uses distroless base image with minimal attack surface

# Build stage - latest minimal Alpine for building only
FROM node:25-alpine3.21 AS builder

# Security hardening - remove all unnecessary packages
RUN apk update && apk upgrade && \
    # Remove any potentially vulnerable packages
    apk del --purge $(apk info | grep -E "(opa|policy|agent)" || echo "") && \
    # Clean up completely
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/* /usr/share/man/* /usr/share/doc/*

WORKDIR /app

# Copy dependency files
COPY package*.json ./

# Install ALL dependencies (needed for TypeScript compilation)
RUN npm install --ignore-scripts && \
    npm cache clean --force

# Copy source code (only what's needed)
COPY src/ ./src/
COPY tsconfig.json ./

# Build application
RUN npm run build && \
    # Clean up and install only production dependencies
    rm -rf src/ tsconfig.json node_modules/ && \
    npm ci --only=production --ignore-scripts && \
    npm cache clean --force

# Final production stage - Latest Google Distroless with security updates
FROM gcr.io/distroless/nodejs20-debian12:nonroot

WORKDIR /app

# Copy ONLY the built application
COPY --from=builder /app/dist ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Distroless already runs as nonroot user
EXPOSE 3000

# Run the application
CMD ["index.js"]